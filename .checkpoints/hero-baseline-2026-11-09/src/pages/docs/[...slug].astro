---
import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDocs, groupDocs } from '../../lib/docs';
import '../../styles/docs.css';

export async function getStaticPaths() {
  const docs = await getDocs();
  return docs.map((doc, index) => ({
    params: { slug: doc.href.replace(/^\/docs\//, '').replace(/\/$/, '') || undefined },
    props: { doc, docs, previous: docs[index - 1], next: docs[index + 1] },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { doc, docs, previous, next } = Astro.props;
const { Content, headings } = await render(doc.entry);
const groups = groupDocs(docs);
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={`${doc.title} · Lighter 文档`} description={doc.description} class="docs-page">
  <div class="docs-mobile-bar"><button id="docs-menu" aria-expanded="false" aria-controls="docs-sidebar">文档目录 <span aria-hidden="true">☰</span></button><span>{doc.label}</span></div>
  <div class="docs-shell">
    <aside class="docs-sidebar" id="docs-sidebar" aria-label="文档导航">
      <div class="docs-search">
        <label for="docs-search">搜索文档</label>
        <div class="search-field"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg><input id="docs-search" type="search" placeholder="搜索文档…" autocomplete="off" aria-controls="search-results" /></div>
        <p class="search-status" role="status" aria-live="polite" id="search-status"></p>
        <ul id="search-results" class="search-results" hidden></ul>
        <noscript><p class="search-status">可通过下方目录浏览全部文档。</p></noscript>
      </div>
      <div class="sidebar-groups">
        {groups.map(group => <section class="sidebar-group"><h2>{group.title}</h2><ul>{group.pages.map(page => <li><a href={page.href} aria-current={page.id === doc.id ? 'page' : undefined}>{page.label}</a></li>)}</ul></section>)}
      </div>
      <a class="ai-docs-link" href="/llms.txt">llms.txt <span aria-hidden="true">↗</span></a>
    </aside>
    <main class="doc-main" id="main">
      <div class="doc-breadcrumb"><a href="/docs/">文档</a><span aria-hidden="true">/</span><span>{doc.section}</span></div>
      <div class="doc-title"><span class="eyebrow">LIGHTER / DOCUMENTATION</span><h1>{doc.title}</h1></div>
      <article class="doc-content"><Content /></article>
      <div class="doc-source"><a href="/llms-full.txt">完整文档（纯文本） <span aria-hidden="true">↗</span></a><a href="https://github.com/Mou2xie/lighter/issues">反馈问题 ↗</a></div>
      <div class="doc-pagination" aria-label="文档翻页">
        {previous ? <a href={previous.href}><span>← 上一页</span><strong>{previous.label}</strong></a> : <span />}
        {next ? <a href={next.href} class="next"><span>下一页 →</span><strong>{next.label}</strong></a> : <span />}
      </div>
    </main>
    <aside class="docs-toc" aria-label="本页目录">
      {toc.length > 0 && <><p>本页内容</p><ol>{toc.map(heading => <li class:list={[{ nested: heading.depth === 3 }]}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></>}
      <div class="docs-version"><span>v0.1.0 / ALPHA</span><p>API 可能发生变化。</p></div>
    </aside>
  </div>
  <script>import '../../scripts/docs';</script>
</BaseLayout>
