---
import { localeFromPath, localizePath, translate } from '../lib/i18n.mjs';
const locale = localeFromPath(Astro.url.pathname);
const other = locale === 'en' ? 'zh' : 'en';
const t = (zh: string, en: string) => translate(locale, zh, en);
const docs = localizePath('/docs/', locale);
---
<header class="site-header"><div class="wrap">
  <a class="brand" href={localizePath('/', locale)} aria-label={t('Lighter 首页', 'Lighter home')}><img class="wordmark" src="/assets/wordmark.svg" width="109" height="38" alt="Lighter" /></a>
  <div class="header-actions">
    <button class="menu" aria-label={t('打开导航', 'Open navigation')} aria-expanded="false" aria-controls="navigation"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    <nav class="site-nav" id="navigation" aria-label={t('主导航', 'Main navigation')}>
      <a href={docs} aria-current={Astro.url.pathname.startsWith(docs) ? 'page' : undefined}>{t('文档', 'Docs')}</a>
      <a href="https://github.com/Mou2xie/lighter">GitHub <span class="arrow">↗</span></a>
    </nav>
    <a class="language-switch" data-language-switch href={localizePath(Astro.url.pathname, other)} hreflang={other === 'en' ? 'en' : 'zh-CN'} lang={other === 'en' ? 'en' : 'zh-CN'} aria-label={t('Switch to English', '切换为中文')}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/></svg>{t('English', '中文')}
    </a>
  </div>
</div></header>
<script>import '../scripts/navigation.js';</script>
