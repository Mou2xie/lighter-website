---
import { localeFromPath, localizePath, translate } from '../lib/i18n.mjs';
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSamples } from "../data/examples";
const locale = localeFromPath(Astro.url.pathname);
const t = (zh: string, en: string) => translate(locale, zh, en);
const samples = getSamples(locale);
const streamSnippet = `for await (const event of
  agent.stream({ messages })) {
  // ${t('处理文本增量', 'Handle text deltas')}
}`;
---
<BaseLayout>
<main id="main">
<section class="hero" aria-labelledby="hero-heading"><div class="wrap"><div class="hero-grid"><div><div class="alpha"><i></i><span>v0.1.0 / ALPHA</span></div><h1 id="hero-heading">{t("轻量化 TypeScript AI Agent 框架", "A lightweight TypeScript AI agent framework")}</h1><p class="hero-description">{t("精简内核，开箱即用，自由拓展", "Lean core. Ready to use. Built to extend.")}</p><div class="actions"><a class="btn btn-primary" href={localizePath("/docs/getting-started/quickstart/", locale)}>{t("开始构建", "Start building")} <span class="arrow">→</span></a><a class="text-link" href="https://github.com/Mou2xie/lighter"><svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.1c-3.12.68-3.78-1.32-3.78-1.32-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.71 2.63 1.22 3.27.93.1-.72.39-1.22.71-1.5-2.49-.28-5.11-1.24-5.11-5.54 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.55.23 2.7.11 2.98.72.79 1.15 1.79 1.15 3.02 0 4.31-2.62 5.26-5.12 5.54.4.35.76 1.03.76 2.08v3.09c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z"/></svg>{t("查看源码", "View source")} <span class="arrow">↗</span></a></div><div class="hero-bottom"><div class="install"><code is:raw><span class="prompt">$</span> npm install @yong_xie/lighter</code><button class="copy" data-copy="npm install @yong_xie/lighter" aria-label={t("复制安装命令", "Copy installation command")}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="1.5"/><path d="M15 8V3H3v13h5"/></svg></button></div></div></div><div class="hero-art" aria-hidden="true"><img class="fire-art" src="/assets/fire.svg" width="420" height="460" alt="" /></div></div></div></section>
<section class="section" id="quickstart"><div class="wrap"><div class="start-grid"><div class="start-copy"><div class="eyebrow">01 / START SMALL</div><h2>{t("几行代码，", "A few lines.")}<br>{t("第一个 Agent。", "Your first agent.")}</h2><ol class="steps"><li><span class="step-number">1</span><div><strong>{t("连接 Provider", "Connect a provider")}</strong></div></li><li><span class="step-number">2</span><div><strong>{t("创建 Agent", "Create an agent")}</strong></div></li><li><span class="step-number">3</span><div><strong>{t("开始运行", "Run it")}</strong></div></li></ol><a class="text-link" href={localizePath("/docs/getting-started/quickstart/", locale)}>{t("快速开始", "Quickstart")} <span class="arrow">↗</span></a></div><div><div class="code-window"><div class="code-title"><span><i></i><b id="filename">hello.ts</b></span><small>TypeScript</small></div><div class="tabs" role="tablist" aria-label={t("代码示例", "Code examples")}><button class="tab" id="tab-basic" role="tab" aria-selected="true" aria-controls="code-panel" data-example="basic">{t("基础调用", "Basic call")}</button><button class="tab" id="tab-tool" role="tab" aria-selected="false" aria-controls="code-panel" tabindex="-1" data-example="tool">{t("工具调用", "Tool use")}</button><button class="tab" id="tab-stream" role="tab" aria-selected="false" aria-controls="code-panel" tabindex="-1" data-example="stream">{t("流式输出", "Streaming")}</button></div><div class="code-body" id="code-panel" role="tabpanel" aria-labelledby="tab-basic" tabindex="0"><button class="copy" id="copy-code" aria-label={t("复制当前示例代码", "Copy current example code")}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="1.5"/><path d="M15 8V3H3v13h5"/></svg></button><pre><code id="source-code">{samples.basic.source}</code></pre></div><div class="code-output"><span>{t("示例输出", "Example output")}</span><code id="output">{samples.basic.output}</code></div></div><p class="code-note">{t("需配置 API key；工具示例需 Zod 4。输出为示意。", "Requires an API key. Tool examples use Zod 4. Outputs are illustrative.")}</p></div></div></div></section>
<section class="loop-section" id="how-it-works"><div class="wrap"><div class="section-head"><div><div class="eyebrow">02 / UNDER THE HOOD</div><h2>{t("精简可靠的核心循环。", "A lean, reliable core loop.")}</h2></div></div><div class="loop"><div class="loop-node loop-node--message"><small>01 / YOUR APPLICATION</small><strong>Message</strong><p>{t("传入消息", "Pass in messages")}</p></div><span class="loop-arrow loop-arrow--input" aria-hidden="true">→</span><div class="loop-node active loop-node--model"><small>02 / LIGHTER CORE</small><strong>Model</strong><p>{t("回复或调用工具", "Reply or call tools")}</p></div><span class="loop-arrow loop-arrow--tool" aria-hidden="true">⇄</span><div class="loop-node loop-node--tool"><small>03 / YOUR CAPABILITIES</small><strong>Tool</strong><p>{t("执行并返回结果", "Execute and return results")}</p></div></div><div class="return-line" aria-hidden="true"><span>{t("回传结果，直到完成回复", "Return results until the response is complete")}</span></div><div class="loop-foot"><a href={localizePath("/docs/advanced/limits/", locale)}>{t("了解运行边界", "Explore runtime limits")} <span class="arrow">↗</span></a></div></div></section>
<section class="section examples" id="examples"><div class="wrap"><div class="section-head"><div><div class="eyebrow">03 / MAKE IT YOURS</div><h2>{t("按需扩展。", "Make it your own.")}</h2></div></div><div class="example-grid"><a class="example" href={localizePath("/docs/guides/tools/", locale)}><div class="example-label"><span>TOOLS</span><span class="index">01</span></div><h3>{t("添加工具", "Add tools")}</h3><code is:raw>new Tool({
  name: "search",
  parametersZodSchema,
  func: search
})</code><div class="example-bottom"><span>{t("查看示例", "View example")}</span><span class="arrow">↗</span></div></a><a class="example" href={localizePath("/docs/guides/streaming/", locale)}><div class="example-label"><span>STREAMING</span><span class="index">02</span></div><h3>{t("流式输出", "Streaming")}</h3><code>{streamSnippet}</code><div class="example-bottom"><span>{t("查看示例", "View example")}</span><span class="arrow">↗</span></div></a><a class="example" href={localizePath("/docs/guides/hooks/", locale)}><div class="example-label"><span>LIFECYCLE HOOKS</span><span class="index">03</span></div><h3>{t("生命周期钩子", "Lifecycle hooks")}</h3><code is:raw>new BeforeModelHook({
  hookName: "log-request",
  hookFunction: (request) => {
    console.log(request);
  }
})</code><div class="example-bottom"><span>{t("查看示例", "View example")}</span><span class="arrow">↗</span></div></a></div></div></section>
<section class="faq-section"><div class="wrap faq-grid"><div class="faq-intro"><div class="eyebrow">04 / A FEW DETAILS</div><h2>{t("常见问题。", "Frequently asked questions.")}</h2><a class="text-link" href="https://github.com/Mou2xie/lighter/issues">{t("GitHub 交流", "Join us on GitHub")} <span class="arrow">↗</span></a></div><div class="faq"><details><summary>{t("需要准备什么？", "What do I need?")}</summary><p>{t("Node.js 22+、ESM 项目，以及模型服务的 API key 和模型 ID。", "Node.js 22+, an ESM project, and an API key and model ID for your provider.")}</p></details><details><summary>{t("哪些能力由应用负责？", "What does my app handle?")}</summary><p>{t("对话存储、运行轮数限制、权限与工具隔离。详见", "Conversation storage, loop limits, permissions, and tool isolation. See ")}<a href={localizePath("/docs/advanced/limits/", locale)}>{t("运行边界", "runtime limits")}</a>{t("。", ".")}</p></details><details><summary>{t("当前版本稳定吗？", "Is the current version stable?")}</summary><p>{t("目前为 Alpha，API 可能发生破坏性变化。", "Lighter is in alpha. Breaking API changes are possible.")}</p></details></div></div></section>
<section class="closing"><div class="wrap"><div><h2>{t("下一簇火花，由你点燃。", "Ignite your next spark.")}</h2></div><a class="btn btn-primary" href={localizePath("/docs/getting-started/quickstart/", locale)}>{t("开始构建", "Start building")} <span class="arrow">↗</span></a></div></section>
</main>
<script>import "../scripts/home.js";</script>
</BaseLayout>
