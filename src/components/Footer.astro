---
import { localeFromPath, localizePath, translate } from '../lib/i18n.mjs';
const locale = localeFromPath(Astro.url.pathname);
const t = (zh: string, en: string) => translate(locale, zh, en);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-brand">
      <a href={localizePath('/', locale)} aria-label={t('回到 Lighter 首页', 'Back to Lighter home')}><img class="wordmark" src="/assets/wordmark.svg" width="79" height="27" alt="Lighter" loading="lazy" /></a>
      <div class="footer-meta">
        <span>© 2026 yong-jie xie</span>
        <a href="https://github.com/Mou2xie/lighter/blob/main/LICENSE">ISC License</a>
      </div>
    </div>
    <div class="footer-links">
      <a href={localizePath('/docs/', locale)}>{t('文档', 'Docs')}</a>
      <a href="https://github.com/Mou2xie/lighter">GitHub ↗</a>
      <a href="https://www.npmjs.com/package/@yong_xie/lighter">npm ↗</a>
      <a href="https://github.com/Mou2xie/lighter/releases">{t('版本更新', 'Releases')} ↗</a>
    </div>
  </div>
</footer>
