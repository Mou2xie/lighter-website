---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found · Lighter">
  <main id="main" class="wrap section">
    <span class="eyebrow">404 / NOT FOUND</span>
    <h1 style="margin-top:24px">This spark is still missing.</h1>
    <p class="muted">Head home or explore the documentation.</p>
    <div class="actions"><a class="btn btn-primary" href="/">Back home →</a><a class="text-link" href="/docs/">Browse docs →</a></div>
  </main>
</BaseLayout>
