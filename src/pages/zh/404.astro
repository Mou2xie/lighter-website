---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到 · Lighter">
  <main id="main" class="wrap section">
    <span class="eyebrow">404 / NOT FOUND</span>
    <h1 style="margin-top:24px">这点火花，暂未找到。</h1>
    <p class="muted">可以返回首页，或从文档继续。</p>
    <div class="actions"><a class="btn btn-primary" href="/zh/">返回首页 →</a><a class="text-link" href="/zh/docs/">浏览文档 →</a></div>
  </main>
</BaseLayout>
